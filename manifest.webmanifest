{
  "name": "WhatHappened",
  "short_name": "WhatHappened",
  "description": "Read a WhatsApp chat and see how a relationship is doing, what changed, and why.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "chat", "accept": ["application/zip", "application/x-zip-compressed", "text/plain", ".zip", ".txt"]}]}
  }
}
